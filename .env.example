# Puerto del servidor
PORT=3000

# Token que configuras en Meta para verificar el webhook (inventa uno)
WHATSAPP_VERIFY_TOKEN=cambia-este-token

# Token de acceso de la app de Meta (WhatsApp Cloud API)
WHATSAPP_ACCESS_TOKEN=

# ID del número de teléfono de WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=

# Versión de la Graph API
WHATSAPP_API_VERSION=v21.0

# Horario de atención con agente (formato 24h, hora local del servidor)
ATC_HORA_INICIO=9
ATC_HORA_FIN=19
